    "@angular/router": "^21.0.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "ag-grid-angular": "^35.1.0",
    "daisyui": "^5.5.18",
    "driver.js": "^1.4.0",
    "rxjs": "~7.8.0",
