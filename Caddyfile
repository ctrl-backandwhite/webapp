{
  admin off
  persist_config off
  auto_https off

  log {
    format json
  }

  servers {
    trusted_proxies static private_ranges
  }
}

:{$PORT} {
  log {
    format json
  }

  # Healthcheck para Railway
  respond /health 200

  # ✅ Sirve el build Angular desde /app/dist/webapp/browser
  # ⚠️ Si tu build genera directamente en /app/dist/webapp, cambia esta línea
  root * /app/dist/webapp/browser

  encode gzip
  file_server

  # ✅ Fallback SPA (para rutas Angular)
  try_files {path} /index.html
}
